{
  "name": "grantfinderstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UK CIC funding intelligence and grant-writing platform",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^2.1.8",
    "oxlint": "^1.81.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
