{
  "name": "grantfinderstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UK CIC funding intelligence and grant-writing platform",
  "scripts": {
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "next dev",
    "start": "next start",
    "migrations:generate": "node scripts/generate-migrations.mjs",
    "prebuild": "node scripts/generate-migrations.mjs",
    "accessibility": "node scripts/accessibility.mjs",
    "smoke": "node scripts/production-smoke.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^2.1.8",
    "axe-core": "^4.13.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "mammoth": "^1.12.2",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  }
