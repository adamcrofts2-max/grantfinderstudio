# Copy to .env.local for development, or set these in your host's dashboard.

# Postgres. Leave unset in development to use the in-memory database, which is
# real PostgreSQL (PGlite) seeded with fictional demo data and lost on restart.
# Required in production. Must request SSL.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Encrypts stored API keys. 32 bytes of base64.
# Generate with: openssl rand -base64 32
# Changing this makes every stored key unreadable — they must be re-entered.
APP_ENCRYPTION_KEY=

# Optional. Points Companies House lookups at a staging or contract-test
# endpoint. Leave unset to use the real service.
# COMPANIES_HOUSE_BASE_URL=

# Anthropic and Companies House API keys are NOT set here. They are entered in
# the app at /settings, verified against the provider, and stored encrypted.
