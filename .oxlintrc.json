{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "dist"
  ],
  "overrides": [
    {
      "files": [
        "src/db/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
